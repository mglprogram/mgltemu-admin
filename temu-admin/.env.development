# 应用端口
VITE_APP_PORT=3000

# 单机模式(true:开启)：纯静态数据，无后端，跳过登录与动态菜单
VITE_STANDALONE=true

# 项目名称
VITE_APP_TITLE=TEMU 运营后台

# 代理前缀
VITE_API_BASE=/dev-api

# 接口地址（单机模式下不使用；日后接后端时改成自己的服务）
VITE_PROXY_TARGET=https://api.youlai.tech

# Mock 开关
VITE_MOCK_ENABLED=false

# 多租户开关
VITE_TENANT_ENABLED=false

# AI 开关
VITE_AI_ENABLED=false