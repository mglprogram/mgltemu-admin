# ===== TEMU 操作域迁移包 · 目标机环境变量（2026-10-08）=====
# 本包已自包含 scripts/lib，METHOD_SCRIPTS_ROOT 可不设；仅当你要重跑完整 ai-python-methodology 闸门时按需填。
# 每行一个：KEY=<按目标机填>

# 项目根（若放在标准位置 %USERPROFILE%\Desktop\团队工具开发 则可不设）
TEAM_TOOL_ROOT=

# ai-python-methodology 的 scripts 根（可选；本包自带 scripts/lib，走自包含优先）
METHOD_SCRIPTS_ROOT=
